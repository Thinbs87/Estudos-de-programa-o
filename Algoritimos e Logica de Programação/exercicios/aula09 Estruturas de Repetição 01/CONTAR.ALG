algoritmo "Contar"
var
   Cont, valor : Inteiro
inicio
  Cont <- 0
  Escreval ("Quer contar até quanto?")
  Leia (valor)
       Enquanto (Cont <= Valor) faca
                Escreval (Cont)
                cont <- cont+1
       Fimenquanto
  Escreval ("Ja terminei de contar")
fimalgoritmo